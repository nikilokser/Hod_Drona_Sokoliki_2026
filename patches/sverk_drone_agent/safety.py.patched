from __future__ import annotations

import math
import os
import re


def env_float(name, default):
    try:
        return float(os.getenv(name, str(default)))
    except (TypeError, ValueError):
        return float(default)


def env_bool(name, default=False):
    raw = str(os.getenv(name, "1" if default else "0")).strip().lower()
    return raw in {"1", "true", "yes", "on", "да"}


def finite_float(value, name):
    try:
        result = float(value)
    except (TypeError, ValueError):
        raise ValueError("%s must be a number" % name)
    if not math.isfinite(result):
        raise ValueError("%s must be finite" % name)
    return result


class DroneSafetyLimits:
    """Local safety envelope controlled exclusively by environment variables."""

    def __init__(self):
        self.max_altitude_m = env_float("DRONE_MAX_ALTITUDE_M", 3.0)
        self.min_flight_altitude_m = env_float("DRONE_MIN_FLIGHT_ALTITUDE_M", 0.20)
        self.max_speed_mps = env_float("DRONE_MAX_SPEED_MPS", 1.0)
        self.max_horizontal_coordinate_m = env_float("DRONE_MAX_HORIZONTAL_COORDINATE_M", 6.0)
        self.max_relative_distance_m = env_float("DRONE_MAX_RELATIVE_DISTANCE_M", 3.0)
        self.max_relative_vertical_m = env_float("DRONE_MAX_RELATIVE_VERTICAL_M", 1.5)
        self.default_speed_mps = env_float("DRONE_DEFAULT_SPEED_MPS", 0.5)
        self.default_takeoff_height_m = env_float("DRONE_DEFAULT_TAKEOFF_HEIGHT_M", 1.0)
        self.arrival_tolerance_m = env_float("DRONE_ARRIVAL_TOLERANCE_M", 0.25)
        self.navigation_timeout_s = env_float("DRONE_NAVIGATION_TIMEOUT_SEC", 60.0)
        self.service_timeout_s = env_float("DRONE_SERVICE_TIMEOUT_SEC", 5.0)
        # Bound for waiting on an actual service call's *response* (e.g. land,
        # navigate). This is deliberately separate from service_timeout_s
        # above, which only bounds rospy.wait_for_service() - checking that a
        # service is registered, a near-instant operation. The call itself
        # can legitimately take longer under real flight load (observed:
        # `land` responding in >5s on real hardware), so it needs its own,
        # more generous budget.
        self.service_call_timeout_s = env_float("DRONE_SERVICE_CALL_TIMEOUT_S", 20.0)
        self.min_takeoff_voltage_v = env_float("DRONE_MIN_TAKEOFF_VOLTAGE_V", 0.0)
        self.require_connected = env_bool("DRONE_REQUIRE_CONNECTED", True)
        self.allowed_frames = {
            item.strip()
            for item in os.getenv(
                "DRONE_ALLOWED_FRAMES",
                "map,body,aruco_map,navigate_target,terrain",
            ).split(",")
            if item.strip()
        }

    def validate_frame(self, frame_id, *, allow_navigate_target=False):
        frame = str(frame_id or "map").strip()
        if not frame:
            frame = "map"
        if frame == "navigate_target" and not allow_navigate_target:
            raise ValueError("navigate_target is reserved for arrival checks and sequences")
        if frame in self.allowed_frames or re.fullmatch(r"aruco_\d+", frame):
            return frame
        raise ValueError("Frame %r is not allowed by DRONE_ALLOWED_FRAMES" % frame)

    def validate_speed(self, speed_mps=None):
        speed = self.default_speed_mps if speed_mps is None else finite_float(speed_mps, "speed_mps")
        if speed <= 0:
            raise ValueError("speed_mps must be greater than zero")
        if speed > self.max_speed_mps:
            raise ValueError(
                "speed_mps %.3f exceeds DRONE_MAX_SPEED_MPS %.3f" % (speed, self.max_speed_mps)
            )
        return speed

    def validate_takeoff_height(self, height_m=None):
        height = self.default_takeoff_height_m if height_m is None else finite_float(height_m, "height_m")
        if height < self.min_flight_altitude_m:
            raise ValueError(
                "Takeoff height %.3f is below DRONE_MIN_FLIGHT_ALTITUDE_M %.3f"
                % (height, self.min_flight_altitude_m)
            )
        if height > self.max_altitude_m:
            raise ValueError(
                "Takeoff height %.3f exceeds DRONE_MAX_ALTITUDE_M %.3f"
                % (height, self.max_altitude_m)
            )
        return height

    def validate_absolute_target(self, x, y, z, frame_id):
        x = finite_float(x, "x")
        y = finite_float(y, "y")
        z = finite_float(z, "z")
        frame = self.validate_frame(frame_id)
        if frame != "body":
            if abs(x) > self.max_horizontal_coordinate_m or abs(y) > self.max_horizontal_coordinate_m:
                raise ValueError(
                    "Target x/y exceeds DRONE_MAX_HORIZONTAL_COORDINATE_M %.3f"
                    % self.max_horizontal_coordinate_m
                )
            if z < self.min_flight_altitude_m or z > self.max_altitude_m:
                raise ValueError(
                    "Target z must be between %.3f and %.3f m; use drone_land for landing"
                    % (self.min_flight_altitude_m, self.max_altitude_m)
                )
        elif frame == "body":
            self.validate_relative_target(x, y, z)
        return x, y, z, frame

    def validate_relative_target(self, forward_m, left_m, up_m):
        forward = finite_float(forward_m, "forward_m")
        left = finite_float(left_m, "left_m")
        up = finite_float(up_m, "up_m")
        horizontal = math.hypot(forward, left)
        if horizontal > self.max_relative_distance_m:
            raise ValueError(
                "Relative horizontal distance %.3f exceeds DRONE_MAX_RELATIVE_DISTANCE_M %.3f"
                % (horizontal, self.max_relative_distance_m)
            )
        if abs(up) > self.max_relative_vertical_m:
            raise ValueError(
                "Relative vertical distance %.3f exceeds DRONE_MAX_RELATIVE_VERTICAL_M %.3f"
                % (abs(up), self.max_relative_vertical_m)
            )
        return forward, left, up
