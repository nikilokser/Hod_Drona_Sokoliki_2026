+    def execute_vote(self, text: str) -> dict[str, object]:
+        """Answers a [ГОЛОСОВАНИЕ] move-negotiation request via a plain LLM
+        chat completion - reuses OpenRouterHost's HTTP call (_post_chat) but
+        with no MCP client/tool list, so the model has no tools to call at
+        all here; the only possible outcomes are a reply string or an
+        error, never a flight action."""
+
+        try:
+            response = self.vote_host._post_chat({
+                "model": self.vote_host.model,
+                "messages": [
+                    {"role": "system", "content": self.vote_host.system_prompt},
+                    {"role": "user", "content": text},
+                ],
+                "temperature": 0.2,
+            })
+            content = str(response["choices"][0]["message"]["content"] or "").strip()
+        except OpenRouterError as exc:
+            return {"success": False, "reply": "Ошибка агента: %s" % exc}
+        except (KeyError, IndexError, TypeError) as exc:
+            return {"success": False, "reply": "Некорректный ответ LLM на голосование: %s" % exc}
+
+        if not content:
+            return {"success": False, "reply": "LLM вернул пустой ответ на голосование."}
+        return {"success": True, "reply": content}
+
